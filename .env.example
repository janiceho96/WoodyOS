NODE_ENV=development
PORT=3001
DATABASE_URL=postgres://nexus:nexus@localhost:5432/nexus
REDIS_URL=redis://localhost:6380
JWT_SECRET=replace-with-a-minimum-32-character-random-secret
LLM_PROVIDER=anthropic
LLM_API_KEY=
LLM_BASE_URL=
LLM_DEFAULT_MODEL=claude-sonnet-4-20250514
ANTHROPIC_API_KEY=
ENCRYPTION_KEY=replace-with-a-32-byte-base64-key
ENCRYPTION_KEY_ID=default
# Optional key rotation map. When set, it replaces ENCRYPTION_KEY lookup:
# ENCRYPTION_KEYS={"default":"base64-32-byte-key","previous":"base64-32-byte-key"}
EMBEDDING_API_URL=
EMBEDDING_API_KEY=
EMBEDDING_MODEL=text-embedding-3-small
EXTRACTOR_URL=http://localhost:8000
EXTRACTOR_TOKEN=change-me
ARTIFACT_STORAGE_DIR=./data/artifacts
AGENT_AVATAR_STORAGE_DIR=./data/agent-avatars
API_PUBLIC_URL=http://localhost:3001
OIDC_ISSUER=
OIDC_CLIENT_ID=
OIDC_CLIENT_SECRET=
OIDC_CALLBACK_URL=
MCP_REGISTRY_URL=https://registry.modelcontextprotocol.io
MCP_REGISTRY_SYNC_INTERVAL_HOURS=6
MCP_OAUTH_CALLBACK_URL=http://localhost:3002/v1/mcp/oauth/callback
MCP_APP_URL=http://localhost:3002
